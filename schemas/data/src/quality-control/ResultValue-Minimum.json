{
  "$id": "https://datastream.org/schema/data/quality-control/ResultValue-Minimum.json",
  "title": "ResultValue-Minimum",
  "description": "Some water quality measurements, for example concentrations, should not have a value lower than zero. Please review these data points and correct as necessary.",
  "errorMessage": "qc-ResultValue-Minimum",
  "if": {
    "type": "object",
    "unevaluatedProperties": true,
    "properties": {
      "ResultValue": true,
      "ResultUnit": {
        "enum": [
          "#/100L",
          "#/100mL",
          "#/day",
          "#/hr",
          "#/min",
          "#/mL",
          "#/sec",
          "Bq/L",
          "CCE/100mL",
          "CE/100mL",
          "cfu/100mL",
          "cfu/mL",
          "cm3",
          "days",
          "DOY",
          "g/L",
          "g/m2",
          "ha",
          "hours",
          "ipiu/100L",
          "kg/t",
          "km2",
          "kPa",
          "L",
          "L/mg-cm",
          "L/mg-m",
          "lm/m2",
          "mBq/L",
          "mg",
          "mg/dm2/day",
          "mg/L",
          "mg/m2",
          "mg/mL",
          "mL",
          "mL/L",
          "mmHg",
          "Mole/L",
          "MPN/100mL",
          "MPN/g",
          "ng",
          "ng/g",
          "ng/L",
          "ng/mL",
          "ohm-cm",
          "ohm-m",
          "pCi/L",
          "per mil",
          "pfu/100L",
          "pfu/100mL",
          "pg/L",
          "pg/mL",
          "ppmv",
          "ppth",
          "psi",
          "T.O.N.",
          "uATM",
          "uE/m2/sec",
          "ug",
          "ug/cm2",
          "ug/kg",
          "ug/L",
          "ug/m3",
          "umol/m2/s",
          "umol/S/m2",
          "units/m"
        ]
      }
    },
    "required": ["ResultValue", "ResultUnit"]
  },
  "then": {
    "type": "object",
    "unevaluatedProperties": true,
    "properties": {
      "ResultValue": {
        "type": "number",
        "minimum": 0
      }
    },
    "required": ["ResultValue"]
  }
}
