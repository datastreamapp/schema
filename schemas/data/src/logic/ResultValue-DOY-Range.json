{
  "$id": "https://datastream.org/schema/data/logic/ResultValue-DOY-Range.json",
  "title": "ResultValue-DOY-Range",
  "description": "The DOY (day of year) cannot be less than 1 or more than 366 (for leap years)",
  "errorMessage": "error-ResultValue-DOY-Range",
  "if": {
    "type": "object",
    "unevaluatedProperties": true,
    "properties": {
      "ResultValue": true,
      "ResultUnit": {
        "enum": ["DOY"]
      }
    },
    "required": ["ResultUnit", "ResultValue"]
  },
  "then": {
    "type": "object",
    "unevaluatedProperties": true,
    "properties": {
      "ResultValue": {
        "type": "integer",
        "minimum": 1,
        "maximum": 366
      }
    },
    "required": ["ResultValue"]
  }
}
