{
  "$id": "https://datastream.org/schema/data/logic/MonitoringLocationType-SurfaceWaterOnly-ActivityMediaName.json",
  "title": "MonitoringLocationType-SurfaceWaterOnly-ActivityMediaName",
  "description": "ActivityMediaName must be 'Surface Water' for surface-water-only MonitoringLocationType values",
  "errorMessage": "error-MonitoringLocationType-SurfaceWaterOnly-ActivityMediaName",
  "if": {
    "type": "object",
    "unevaluatedProperties": true,
    "properties": {
      "MonitoringLocationType": {
        "enum": [
          "Atmosphere",
          "Canal Drainage",
          "Canal Irrigation",
          "Canal Transport",
          "Estuary",
          "Great Lake",
          "Lake/Pond",
          "Ocean",
          "Pond-Stormwater",
          "Reservoir",
          "River/Stream",
          "Storm Sewer",
          "Unspecified",
          "Wetland"
        ]
      }
    },
    "required": [
      "MonitoringLocationType"
    ]
  },
  "then": {
    "type": "object",
    "unevaluatedProperties": true,
    "properties": {
      "ActivityMediaName": {
        "enum": [
          "Surface Water"
        ]
      }
    },
    "required": [
      "ActivityMediaName"
    ]
  }
}
